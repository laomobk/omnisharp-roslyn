<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <UseRoslynNetStandardAssets Condition="'$(MSBuildProjectName)' == 'OmniSharp.Cake' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.DotNetTest' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.Host' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.Http.Driver' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.LanguageServerProtocol' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.MSBuild' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.Roslyn' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.Roslyn.CSharp' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.Script' Or
                                             '$(MSBuildProjectName)' == 'OmniSharp.Stdio.Driver'">true</UseRoslynNetStandardAssets>
  </PropertyGroup>

  <!--
      Roslyn's OmniSharp ExternalAccess assemblies target .NET Standard 2.0 and
      use internal APIs from the matching Roslyn assets. A net8.0 project would
      otherwise select Roslyn's net8.0 assets, whose internal API signatures are
      different, and fail at startup with MissingMethodException.
  -->
  <ItemGroup Condition="'$(UseRoslynNetStandardAssets)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.Common" ExcludeAssets="Compile;Runtime" GeneratePathProperty="true" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_Common)\lib\netstandard2.0\Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.Features" ExcludeAssets="Compile;Runtime" GeneratePathProperty="true" />
    <Reference Include="Microsoft.CodeAnalysis.Features">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_Features)\lib\netstandard2.0\Microsoft.CodeAnalysis.Features.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.Scripting.Common" ExcludeAssets="Compile;Runtime" GeneratePathProperty="true" />
    <Reference Include="Microsoft.CodeAnalysis.Scripting">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_Scripting_Common)\lib\netstandard2.0\Microsoft.CodeAnalysis.Scripting.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" ExcludeAssets="Compile;Runtime" GeneratePathProperty="true" />
    <Reference Include="Microsoft.CodeAnalysis.Workspaces">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_Workspaces_Common)\lib\netstandard2.0\Microsoft.CodeAnalysis.Workspaces.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" ExcludeAssets="Compile;Runtime" GeneratePathProperty="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_CSharp)\lib\netstandard2.0\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" ExcludeAssets="Compile;Runtime" GeneratePathProperty="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Features">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_CSharp_Features)\lib\netstandard2.0\Microsoft.CodeAnalysis.CSharp.Features.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" ExcludeAssets="Compile;Runtime" GeneratePathProperty="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Scripting">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_CSharp_Scripting)\lib\netstandard2.0\Microsoft.CodeAnalysis.CSharp.Scripting.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" ExcludeAssets="Compile;Runtime" GeneratePathProperty="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp.Workspaces">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_CSharp_Workspaces)\lib\netstandard2.0\Microsoft.CodeAnalysis.CSharp.Workspaces.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
